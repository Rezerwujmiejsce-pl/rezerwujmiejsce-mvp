# Skopiuj do .env.local. Nie wkładaj tu prawdziwych kluczy produkcyjnych.
# Wartości lokalne pokazuje: supabase status -o env

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=wklej_klucz_anon_z_supabase_status

# Adres połączenia z bazy (DB_URL z `supabase status -o env`).
# Skrypt administratora woła private.bootstrap_admin przez psql, nie przez API.
# SUPABASE_DB_URL=postgresql://postgres:haslo@127.0.0.1:54322/postgres

# Klucz service role nie jest używany przez stronę. Nie dodawaj mu NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Opcjonalnie, gdy coordinator świadomie puszcza bootstrap na zdalny DEV.
# Bez tej zgody skrypt odmawia adresów innych niż 127.0.0.1 i localhost.
# ALLOW_REMOTE_BOOTSTRAP=yes
